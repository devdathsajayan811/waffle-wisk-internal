{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|uploads|assets|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
