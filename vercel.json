{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "node_modules/sql.js/dist/**",
        "waffle_wisk.db"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|uploads|assets|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
