# Required. At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Database. When TURSO_DATABASE_URL is set it wins; otherwise a local SQLite file (sql.js) is used.
# On Vercel the local file lives in /tmp and is NOT durable, so production must use Turso.
DATABASE_PATH=./waffle_wisk.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Demo data (admin/admin123, staff/staff123, sample products). Defaults to true outside production.
SEED_DEMO_DATA=

# First admin, created only when the users table is empty and demo data is off.
ADMIN_NAME=Administrator
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated list of browser origins allowed to call the API cross-origin.
# Same-origin requests (the Vite proxy, the Vercel deployment itself) never need this.
CORS_ORIGINS=

# Login and forgot-password attempts allowed per IP per 15 minutes.
LOGIN_RATE_LIMIT=10

# Vercel Blob token for product images. Without it, images go to ./uploads locally
# and uploads are disabled on Vercel.
BLOB_READ_WRITE_TOKEN=

PORT=5000
